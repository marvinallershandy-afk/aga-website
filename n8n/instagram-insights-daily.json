    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Story-Insights -> Rohzeile. captured_at aus Config = Verlaufsachse innerhalb 24h;\n// mehrere Zeilen/Tag/Story sind gewollt (DB-Index erlaubt es).\nconst cfg = $('Config: Stories').first().json;\nconst story = $('Fan Out Stories').item.json;\nconst resp = $json || {};\nconst vals = {};\nfor (const m of (resp.data || [])) {\n  const v = (m.values && m.values[0]) ? m.values[0].value : null;\n  vals[m.name] = v;\n}\nreturn { json: {\n  ebene: 'story',\n  object_id: String(story.id),\n  snapshot_date: cfg.snapshot_date,\n  captured_at: cfg.captured_at,\n  period: 'story',\n  media_type: story.media_type ?? null,\n  media_product_type: story.media_product_type ?? null,\n  permalink: story.permalink ?? null,\n  media_published_at: story.timestamp ?? null,\n  reach: vals.reach ?? null,\n  replies: vals.replies ?? null,\n  exits: vals.exits ?? null,\n  taps_forward: vals.taps_forward ?? null,\n  taps_back: vals.taps_back ?? null,\n  shares: vals.shares ?? null,\n  raw: { story, insights: resp },\n} };"
      },
