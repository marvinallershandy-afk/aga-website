        "method": "GET",
        "url": "={{ $('Config: Konto+Beitrag').first().json.graph_base }}/{{ $('Config: Konto+Beitrag').first().json.graph_version }}/{{ $('Config: Konto+Beitrag').first().json.ig_user_id }}/insights?metric=follower_demographics&period=lifetime&metric_type=total_value&breakdown=country&timeframe=this_month",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "get-konto-demographics",
      "name": "Get Konto Demographics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        -420
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "PLACEHOLDER_SVA_META_TOKEN",
          "name": "SVA Meta Graph Token (access_token)"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Konto-Zeitreihe (period=day) in eine Rohzeile je Tag zerlegen. APPEND-ONLY:\n// snapshot_date kommt aus dem API-end_time jedes Datenpunkts (nicht \"heute\").\nconst cfg = $('Config: Konto+Beitrag').first().json;\nconst igUserId = cfg.ig_user_id;\nconst body = $input.first().json || {};\nconst series = {};\nfor (const m of (body.data || [])) {\n  for (const v of (m.values || [])) {\n    const d = (v.end_time || '').slice(0, 10);\n    if (!d) continue;\n    (series[d] = series[d] || {})[m.name] = v.value;\n  }\n}\nlet audience = null;\ntry {\n  const demo = $('Get Konto Demographics').first().json;\n  if (demo && demo.data) audience = demo.data;\n} catch (e) {}\nconst dates = Object.keys(series);\nconst rows = dates.map((d) => ({\n  ebene: 'konto',\n  object_id: String(igUserId),\n  snapshot_date: d,\n  period: 'day',\n  reach: series[d].reach ?? null,\n  follower_count: series[d].follower_count ?? null,\n  audience: audience,\n  raw: { insights: body, demographics: audience },\n}));\nreturn rows.map((r) => ({ json: r }));"
      },
      "id": "build-konto-rows",
      "name": "Build Konto Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        -340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config: Konto+Beitrag').first().json.graph_base }}/{{ $('Config: Konto+Beitrag').first().json.graph_version }}/{{ $('Config: Konto+Beitrag').first().json.ig_user_id }}/media?fields=id,caption,media_type,media_product_type,permalink,timestamp,like_count,comments_count&since={{ $('Config: Konto+Beitrag').first().json.since }}&until={{ $('Config: Konto+Beitrag').first().json.until }}&limit=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": []
              },
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.paging ? $response.body.paging.next : '' }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging || !$response.body.paging.next }}",
              "limitPagesFetched": true,
              "maxRequestsPerPagination": 20,
              "requestInterval": 700
            }
          }
        }
      },
      "id": "get-media-list",
      "name": "Get Media List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        100
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "PLACEHOLDER_SVA_META_TOKEN",
          "name": "SVA Meta Graph Token (access_token)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Alle Medien (ueber alle Seiten) flach ausrollen; Metric-Set je Medientyp\n// tailoren (unsupported Metrik => Meta 400 fuer den ganzen Call).\nconst out = [];\nfor (const it of $input.all()) {\n  const data = (it.json && it.json.data) ? it.json.data : (Array.isArray(it.json) ? it.json : []);\n  for (const m of data) {\n    const isVideo = m.media_type === 'VIDEO' || m.media_product_type === 'REELS';\n    const metric = isVideo\n      ? 'reach,saved,likes,comments,shares,total_interactions,views'\n      : 'reach,saved,likes,comments,shares,total_interactions';\n    out.push({ json: { ...m, __metric: metric } });\n  }\n}\nreturn out;"
      },
      "id": "fan-out-media",
      "name": "Fan Out Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config: Konto+Beitrag').first().json.graph_base }}/{{ $('Config: Konto+Beitrag').first().json.graph_version }}/{{ $json.id }}/insights?metric={{ $json.__metric }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 30,
              "batchInterval": 1200
            }
          }
        }
      },
      "id": "get-media-insights",
      "name": "Get Media Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
