    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Alle Zeilen zu EINEM Batch-Array fuer die Append-RPC buendeln.\nconst rows = $input.all().map((i) => i.json).filter(Boolean);\nreturn [{ json: { p_rows: rows, count: rows.length } }];"
      },
