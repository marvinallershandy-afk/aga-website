    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aktive Stories ausrollen; Story-Metriken sind nach 24h endgueltig weg.\nconst out = [];\nfor (const it of $input.all()) {\n  const data = (it.json && it.json.data) ? it.json.data : (Array.isArray(it.json) ? it.json : []);\n  for (const s of data) {\n    out.push({ json: { ...s, __metric: 'reach,replies,exits,taps_forward,taps_back,shares' } });\n  }\n}\nreturn out;"
      },
