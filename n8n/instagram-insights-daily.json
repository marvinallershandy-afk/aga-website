    {
      "parameters": {},
      "id": "skip-failed-media",
      "name": "Skip Failed Media",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ein Beitrags-Insights-Response + zugehoerige Media-Metadaten -> eine Rohzeile.\nconst cfg = $('Config: Konto+Beitrag').first().json;\nconst media = $('Fan Out Media').item.json;\nconst resp = $json || {};\nconst vals = {};\nfor (const m of (resp.data || [])) {\n  const v = (m.values && m.values[0]) ? m.values[0].value\n          : (m.total_value ? m.total_value.value : null);\n  vals[m.name] = v;\n}\nreturn { json: {\n  ebene: 'beitrag',\n  object_id: String(media.id),\n  snapshot_date: cfg.snapshot_date,\n  period: 'lifetime',\n  media_type: media.media_type ?? null,\n  media_product_type: media.media_product_type ?? null,\n  permalink: media.permalink ?? null,\n  caption: media.caption ?? null,\n  media_published_at: media.timestamp ?? null,\n  reach: vals.reach ?? null,\n  saved: vals.saved ?? null,\n  likes: vals.likes ?? (media.like_count ?? null),\n  comments: vals.comments ?? (media.comments_count ?? null),\n  shares: vals.shares ?? null,\n  total_interactions: vals.total_interactions ?? null,\n  views: vals.views ?? null,\n  raw: { media, insights: resp },\n} };"
      },
      "id": "build-media-rows",
      "name": "Build Media Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-kb",
      "name": "Merge Konto+Beitrag",
